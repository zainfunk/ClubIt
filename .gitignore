# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# iOS device build output (xcodebuild -derivedDataPath)
/build-device

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# local Claude Code config (contains API keys / personal settings)
.claude/
.mcp.json

# husky internal directory (regenerated by `npm install` on clone)
.husky/_/

# Playwright + local test artifacts (W2.6 cleanup)
test-results/
playwright-report/
tests/e2e/.auth/
tests/e2e/.chrome-data/
tests/e2e/screenshots/
.playwright-mcp/
