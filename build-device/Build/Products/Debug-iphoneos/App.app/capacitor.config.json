{
	"appId": "com.clubit.app",
	"appName": "ClubIt",
	"webDir": "public",
	"appendUserAgent": "ClubItNativeApp",
	"server": {
		"url": "https://clubit.app",
		"androidScheme": "https",
		"allowNavigation": [
			"clubit.app",
			"*.clubit.app"
		]
	},
	"plugins": {
		"SplashScreen": {
			"launchAutoHide": false,
			"backgroundColor": "#4f46e5",
			"showSpinner": false
		}
	},
	"packageClassList": [
		"BarcodeScannerPlugin",
		"AppPlugin",
		"CAPBrowserPlugin",
		"HapticsPlugin",
		"KeyboardPlugin",
		"PushNotificationsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
