    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
